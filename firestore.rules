rules_version = '2';

/* V5.15 rules: same participant-write / no-read policy, plus tightly scoped
 * idempotent retry updates and a bonus post-task survey subcollection. */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownedByCaller() {
      return request.resource.data.uid == request.auth.uid;
    }

    function sameOwner() {
      return signedIn()
             && resource.data.uid == request.auth.uid
             && request.resource.data.uid == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow create: if signedIn()
                    && ownedByCaller()
                    && request.resource.data.keys().hasAll(
                         ['uid', 'sessionId', 'experimentId', 'startedAt'])
                    && request.resource.data.sessionId == sessionId
                    && request.resource.data.experimentId is string
                    && request.resource.data.experimentId.size() <= 96
                    && request.resource.data.participantId is string
                    && request.resource.data.participantId.size() <= 128;

      // A timed-out retry sends the same payload; only the server timestamp may differ.
      allow update: if sameOwner()
                    && request.resource.data.sessionId == sessionId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finishedAt']);

      allow read, delete: if false;

      match /chunks/{chunkId} {
        allow create: if signedIn()
                      && ownedByCaller()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.frames is list
                      && request.resource.data.frames.size() <= 2000;

        allow update: if sameOwner()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadedAt']);

        allow read, delete: if false;
      }

      match /trialSummaries/{trialId} {
        allow create: if signedIn()
                      && ownedByCaller()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.trialIndex is int;

        allow update: if sameOwner()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedAt']);

        allow read, delete: if false;
      }

      match /postTaskSurvey/{surveyId} {
        allow create: if signedIn()
                      && ownedByCaller()
                      && request.resource.data.sessionId == sessionId;

        allow update: if sameOwner()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedAt']);

        allow read, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
