rules_version = '2';

/* V5.18.3 rules: participant-write / no-read policy, plus a mutable parent
 * session document for checkpoints and final status. Core identity fields are
 * immutable after the parent document is created. */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownedByCaller() {
      return request.resource.data.uid == request.auth.uid;
    }

    function sameOwner() {
      return signedIn()
             && resource.data.uid == request.auth.uid
             && request.resource.data.uid == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow create: if signedIn()
                    && ownedByCaller()
                    && request.resource.data.keys().hasAll(
                         ['uid', 'sessionId', 'experimentId', 'startedAt'])
                    && request.resource.data.sessionId == sessionId
                    && request.resource.data.experimentId is string
                    && request.resource.data.experimentId.size() <= 96
                    && request.resource.data.participantId is string
                    && request.resource.data.participantId.size() <= 128;

      // V5.18.3 creates the parent record at study start, then merges small
      // checkpoints and the final session summary into that same document.
      // Identity/ownership fields cannot be changed after creation.
      allow update: if sameOwner()
                    && request.resource.data.sessionId == sessionId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.experimentId == resource.data.experimentId
                    && request.resource.data.participantId == resource.data.participantId
                    && request.resource.data.startedAt == resource.data.startedAt
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                         ['uid', 'sessionId', 'experimentId', 'participantId', 'startedAt']);

      allow read, delete: if false;

      match /chunks/{chunkId} {
        allow create: if signedIn()
                      && ownedByCaller()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.frames is list
                      && request.resource.data.frames.size() <= 2000;

        allow update: if sameOwner()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadedAt']);

        allow read, delete: if false;
      }

      match /trialSummaries/{trialId} {
        allow create: if signedIn()
                      && ownedByCaller()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.trialIndex is int;

        allow update: if sameOwner()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedAt']);

        allow read, delete: if false;
      }

      match /postTaskSurvey/{surveyId} {
        allow create: if signedIn()
                      && ownedByCaller()
                      && request.resource.data.sessionId == sessionId;

        allow update: if sameOwner()
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedAt']);

        allow read, delete: if false;
      }

      match /postTaskSurvey/{responseId} {

        allow create: if signedIn()
                      && ownedByCaller()
                      && request.resource.data.sessionId == sessionId
                      && responseId == 'response';

        allow read, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
